function BehavioralMain(app)
    % This function runs the behavioral experiment by reading its configuration
    % from mdb.mat and using the project's standard playback functions.

    % Load the master database
    load mdb.mat;

    % --- DEBUGGING LINE ---
    disp(['[DEBUG] Interactive mode flag from mdb.mat is: ', num2str(mdb.behavioral.interactive)]);

    % Check if a behavioral experiment is configured
    if isfield(mdb, 'behavioral') && isfield(mdb.behavioral, 'mode')
        
        % --- 1. Setup and File Discovery ---
        
        
        folderPath = mdb.behavioral.folderPath;
        fileList = dir(fullfile(folderPath, '*.wav'));
        expression = '^(\d+)\s-\s.*\.wav$';
        filesToPlay = {};
        for i = 1:length(fileList)
            [tokens, ~] = regexp(fileList(i).name, expression, 'tokens', 'match');
            if ~isempty(tokens)
                order = str2double(tokens{1}{1});
                filesToPlay{end+1} = struct('name', fileList(i).name, 'order', order);
            end
        end
        
        if ~isempty(filesToPlay)
            orderArray = cellfun(@(s) s.order, filesToPlay);
            [~, sortIdx] = sort(orderArray);
            filesToPlay = filesToPlay(sortIdx);
        else
            errordlg('No correctly named .wav files found in the selected folder.', 'File Error');
            return;
        end

        % --- 2. Main Experiment Loop ---
        results = {}; % Initialize results cell array
        noise_active = isfield(mdb, 'master') && mdb.master.TX2_select;

        for i = 1:length(filesToPlay)
            fileName = filesToPlay{i}.name;
            filePath = fullfile(folderPath, fileName);
            
            % --- 2a. Update mdb for the current word ---
            [~, ~, file_ext] = fileparts(filePath);
            audio_info = audioinfo(filePath);
            mdb.TX1.stimulus.speech.file = filePath;
            mdb.TX1.stimulus.speech.file_ext = file_ext;
            
            % --- 2b. Set Noise Phase if noise is active ---
            noise_phase = 'N/A';
            if noise_active
                if randi([0, 1]) == 0
                    mdb.TX2.stimulus.noise.phase = 0;
                    noise_phase = 0;
                else
                    mdb.TX2.stimulus.noise.phase = 90;
                    noise_phase = 90;
                end
            end
            
            save('mdb.mat', 'mdb'); % Save mdb with updated file path and phase
            
            % --- 2c. Play the sound ---
            play_signal_multi(mdb.master.TX1_select, mdb.master.TX2_select, mdb.master.TX3_select);
            pause(audio_info.Duration + 0.2); % Pause for the duration of the audio + a small buffer
            TXall_stop_signal();
            
            % --- 2d. Handle Interactive Mode ---
            pass_fail_status = 'N/A';
            if mdb.behavioral.interactive
                selection = uiconfirm(app.UIFigure, ['Word played: ' fileName], 'Response', ...
                                      'Options', {'Pass', 'Fail', 'Cancel'}, 'DefaultOption', 1);
                
                switch selection
                    case 'Pass'
                        pass_fail_status = 'Pass';
                    case 'Fail'
                        pass_fail_status = 'Fail';
                    case 'Cancel'
                        uialert(app.UIFigure, 'Experiment cancelled by user.', 'Cancelled');
                        return; % Exit the function
                end
            end
            
            % --- 2e. Record Results for this trial ---
            results{i, 1} = fileName;
            results{i, 2} = noise_phase;
            results{i, 3} = pass_fail_status;
        end
        
        % --- 3. Generate and Save Report ---
        
        % Create the output directory if it doesn't exist
        if ~exist(outputDir, 'dir')
            mkdir(outputDir);
        end
        
        % Prepare data for Excel report
        outputExcelFile = fullfile(outputDir, [mdb.behavioral.patient.testName, '.xlsx']);
        
        % Sheet 1: Patient and Test Info
        patientInfo = {
            'Patient Name', mdb.behavioral.patient.name;
            'Patient Age', mdb.behavioral.patient.age;
            'Patient Gender', mdb.behavioral.patient.gender;
            'Tested Ear', mdb.behavioral.patient.ear;
            'Test Name', mdb.behavioral.patient.testName;
            'Test Date', char(datetime('now'));
            'Mode', mdb.behavioral.mode;
        };
        writecell(patientInfo, outputExcelFile, 'Sheet', 'General Info', 'Range', 'A1');
        
        % Sheet 2: Configuration Summary
        configSummary = PrintData(mdb);
        writecell(configSummary, outputExcelFile, 'Sheet', 'Configuration');
        
        % Sheet 3: Results
        resultsHeader = {'File Name', 'Noise Phase', 'Status'};
        resultsTable = cell2table(results, 'VariableNames', resultsHeader);
        writetable(resultsTable, outputExcelFile, 'Sheet', 'Results');
        
        uialert(app.UIFigure, ['Experiment finished. Report saved to ' outputExcelFile], 'Report Saved');

        uialert(app.UIFigure, ['Experiment finished. Report saved to ' outputExcelFile], 'Report Saved');
        
    end
end